classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(title) None
        +complete_task(task) Optional~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool completed
        +str time
        +str frequency
        +date due_date
        +mark_complete() None
        +priority_value() int
        +start_minutes() Optional~int~
        +end_minutes() Optional~int~
        +next_occurrence() Optional~Task~
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +list~Task~ skipped
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +generate_plan() list~Task~
        +detect_conflicts(tasks) list~str~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : schedules
